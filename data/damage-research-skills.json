    "affinity": {
      "status": "verified",
      "min": -100,
      "max": 100,
      "negativeCritMultiplier": 0.75,
      "basePositiveCritMultiplier": 1.25,
      "expectedRawFactor": "a=clamp(affinity,-100,100)/100; a>=0 ? 1+a*(critMultiplier-1) : 1+0.25*a",
      "expectedElementFactor": "1+max(0,clamp(affinity,-100,100)/100)*(criticalElement-1)",
      "sourceIds": [
        "general",
        "sa"
      ],
      "notes": [
